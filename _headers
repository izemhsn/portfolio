# Netlify response headers. Netlify reads this file at deploy time and doesn't publish it.
# Compression (Brotli/gzip) and HTTPS/HSTS are handled by Netlify itself.

/*
  # Only this site's own files may load (the font is self-hosted). The JSON-LD
  # block is data, not a script, so script-src 'self' doesn't block it.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# HTML, CSS and JS keep Netlify's default (always revalidate) because their
# file names never change, so edits show up on the next visit.

# Images rarely change: cache for a week, refresh in the background after that.
/assets/shots/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Font files carry a version in their name and never change in place.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The résumé changes when it's updated, so revalidate it daily.
/assets/*.pdf
  Cache-Control: public, max-age=86400
